{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run (Debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net8.0-windows/win-x64/PushToTalkDictation.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false,
      "requireExactSource": false
    },
    {
      "name": "Run (Debug, hooks off at start)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net8.0-windows/win-x64/PushToTalkDictation.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false,
      "env": {
        // Starts inactive so you can arm breakpoints before the keyboard hook is live.
        "PTTD_StartActive": "false",
        "PTTD_Logging__MinimumLevel": "Debug"
      }
    },
    {
      "name": "Attach to running instance",
      "type": "coreclr",
      "request": "attach",
      "processName": "PushToTalkDictation.exe"
    }
  ]
}
